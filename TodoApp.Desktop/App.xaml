<Application x:Class="TodoApp.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TodoApp.Desktop.ViewModels"
             xmlns:v="clr-namespace:TodoApp.Desktop.Views">
    
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <v:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <v:RegisterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TodoListViewModel}">
            <v:TodoListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddTaskViewModel}">
            <v:AddTaskView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditTaskViewModel}">
            <v:EditTaskView />
        </DataTemplate>
    </Application.Resources>
</Application>