<UserControl x:Class="TodoApp.Desktop.Views.AddTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <TextBlock Text="Новая задача" FontSize="20" FontWeight="SemiBold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>
        
        <TextBlock Text="Текст задачи:" Margin="0,0,0,4"/>
        <TextBox Text="{Binding TaskText, UpdateSourceTrigger=PropertyChanged}" 
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" 
                 Padding="6" Margin="0,0,0,10"/>
                 
        <TextBlock Text="{Binding ValidationMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                    Width="110" Margin="0,0,10,0" Padding="6"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" 
                    Width="110" Padding="6"/>
        </StackPanel>
    </StackPanel>
</UserControl>