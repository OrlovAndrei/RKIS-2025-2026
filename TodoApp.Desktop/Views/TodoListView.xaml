<UserControl x:Class="TodoApp.Desktop.Views.TodoListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="250" Padding="6" Margin="0,0,10,0" 
                     ToolTip="Поиск по тексту задачи"/>
            
            <ComboBox ItemsSource="{Binding AvailableStatuses}" 
                      SelectedItem="{Binding FilterStatus}" 
                      Width="160" Padding="6" Margin="0,0,10,0" 
                      ToolTip="Фильтр по статусу"/>
            
            <Button Content="Добавить" Command="{Binding AddTaskCommand}" 
                    Padding="10,6" VerticalAlignment="Center"/>
        </StackPanel>


        <ListView ItemsSource="{Binding Tasks}" 
                  SelectedItem="{Binding SelectedTask}" 
                  Margin="0,0,0,10"
                  BorderBrush="#D0D0D0" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Задача" Width="450" DisplayMemberBinding="{Binding Text}"/>
                    <GridViewColumn Header="Статус" Width="130" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="Изменено" Width="140" 
                                    DisplayMemberBinding="{Binding LastUpdate, StringFormat=dd.MM.yyyy HH:mm}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сменить статус" Command="{Binding ChangeStatusCommand}" 
                    Margin="0,0,8,0" Padding="10,5"/>
            <Button Content="Редактировать" Command="{Binding EditTaskCommand}" 
                    Margin="0,0,8,0" Padding="10,5"/>
            <Button Content="🗑 Удалить" Command="{Binding DeleteTaskCommand}" 
                    Padding="10,5" Background="#FFE0E0" BorderBrush="#CCAAAA"/>
        </StackPanel>
    </DockPanel>
</UserControl>