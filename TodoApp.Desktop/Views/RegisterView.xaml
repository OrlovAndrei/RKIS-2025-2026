<UserControl x:Class="TodoApp.Desktop.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="350" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <TextBlock Text="Регистрация" FontSize="22" FontWeight="SemiBold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <TextBlock Text="Логин:" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="6"/>
        
        <TextBlock Text="Пароль:" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="6"/>
        
        <TextBlock Text="Имя:" Margin="0,0,0,4"/>
        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="6"/>
        
        <TextBlock Text="Фамилия:" Margin="0,0,0,4"/>
        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="6"/>
        
        <TextBlock Text="Год рождения:" Margin="0,0,0,4"/>
        <TextBox Text="{Binding BirthYear, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,15" Padding="6"/>
        
        <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}" 
                Margin="0,0,0,10" Padding="10,6" FontSize="14"/>
        
        <Button Content="Уже есть аккаунт? Войти" Command="{Binding GoToLoginCommand}" 
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" HorizontalAlignment="Center"/>
                
        <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap" 
                   HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="13"/>
    </StackPanel>
</UserControl>